# Dataset files (large, should not be in version control)
# Exclude all CSV and PKL files
*.csv
*.pkl
dataset_summary.json
data/*.json

# Tracked contracts and historical outputs
!app/data/*.csv
!app/data/*.csv.gz
!app/data/dashboard_manifest.json
!artifacts/historical_dashboard/*.csv
!tests/fixtures/dashboard/*.csv

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log

# Local agent planning context (never pushed)
context/
graphify-out/
.serena/
.worktrees/

# Node build files
node_modules/
